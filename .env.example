# ─────────────────────────────────────────────────────────────────────────────
# Slotify — Environment Variables Template
# Copy this file to .env for local development.
# In production, set these directly in Vercel Dashboard →
#   Project → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (PostgreSQL via Supabase) ────────────────────────────────────────
#
# LOCAL DEV:
#   Use the direct connection string from Supabase → Settings → Database → URI
#   Example: postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
#
# PRODUCTION (Vercel):
#   ⚠️  Use the TRANSACTION POOLER URL (port 6543), NOT the direct URL (port 5432).
#   Vercel serverless functions each open their own pool; the pooler prevents
#   exhausting Supabase's connection limit.
#   Supabase → Project → Settings → Database → Transaction pooler
#   Example: postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true
#
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/slotify?sslmode=disable

# ── JWT Session Signing ───────────────────────────────────────────────────────
# Used to sign/verify user session cookies (HS256, 7-day expiry).
# Generate a secure value:  openssl rand -hex 32
JWT_SECRET=replace_with_64_char_hex_secret

# ── Cron Job Security ─────────────────────────────────────────────────────────
# Protects /api/cron/reminders from unauthorized invocations.
# Vercel Cron automatically sends this as: Authorization: Bearer <CRON_SECRET>
# Generate a secure value:  openssl rand -hex 32
# Also used to protect /api/debug-db and /api/full-diag endpoints.
CRON_SECRET=replace_with_64_char_hex_secret

# ── Meta WhatsApp Business API ────────────────────────────────────────────────
# WHATSAPP_VERIFY_TOKEN:
#   A string you choose — set the SAME value in:
#   Meta App Dashboard → WhatsApp → Configuration → Webhook → Verify Token
WHATSAPP_VERIFY_TOKEN=your_chosen_verify_token

# WHATSAPP_APP_SECRET:
#   Meta App Dashboard → App Settings → Basic → App Secret
#   Used to verify X-Hub-Signature-256 on incoming webhook requests.
WHATSAPP_APP_SECRET=your_meta_app_secret

# WHATSAPP_API_VERSION:
#   Meta Graph API version. Check https://developers.facebook.com/docs/graph-api/changelog
#   for the latest stable version.
WHATSAPP_API_VERSION=v19.0

# ── Superadmin Credentials ────────────────────────────────────────────────────
# Login credentials for the /superadmin dashboard.
# ⚠️  Use strong, unique credentials in production — not the same as local dev.
SUPERADMIN_USERNAME=your_admin_username
SUPERADMIN_PASSWORD=your_strong_admin_password

# ── Optional: Supabase JS Client (not currently used) ────────────────────────
# Only required if client-side Supabase features are added (Realtime, Storage, etc.)
# Supabase → Project → Settings → API
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
