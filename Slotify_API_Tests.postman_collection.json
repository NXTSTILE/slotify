{
  "info": {
    "name": "Slotify API Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. GET /api/whatsapp/webhook",
      "item": [
        {
          "name": "Happy Path: Verification Handshake",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/api/whatsapp/webhook?hub.mode=subscribe&hub.verify_token={{VERIFY_TOKEN}}&hub.challenge=1158201444",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "api",
                "whatsapp",
                "webhook"
              ],
              "query": [
                {
                  "key": "hub.mode",
                  "value": "subscribe"
                },
                {
                  "key": "hub.verify_token",
                  "value": "{{VERIFY_TOKEN}}"
                },
                {
                  "key": "hub.challenge",
                  "value": "1158201444"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response is challenge string\", function () {",
                  "    pm.expect(pm.response.text()).to.eql(\"1158201444\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Auth Failure: Wrong Verify Token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/api/whatsapp/webhook?hub.mode=subscribe&hub.verify_token=wrong_token&hub.challenge=1158201444",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "api",
                "whatsapp",
                "webhook"
              ],
              "query": [
                {
                  "key": "hub.mode",
                  "value": "subscribe"
                },
                {
                  "key": "hub.verify_token",
                  "value": "wrong_token"
                },
                {
                  "key": "hub.challenge",
                  "value": "1158201444"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 403\", function () {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Bad Input: Missing Params",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/api/whatsapp/webhook",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "api",
                "whatsapp",
                "webhook"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 403\", function () {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. POST /api/whatsapp/webhook",
      "item": [
        {
          "name": "Happy Path: Valid Signature",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"object\": \"whatsapp_business_account\",\n  \"entry\": [\n    {\n      \"id\": \"12345\",\n      \"changes\": [\n        {\n          \"value\": {\n            \"messaging_product\": \"whatsapp\",\n            \"metadata\": {\n              \"display_phone_number\": \"16505551111\",\n              \"phone_number_id\": \"123456123\"\n            },\n            \"contacts\": [\n              {\n                \"profile\": {\n                  \"name\": \"Test User\"\n                },\n                \"wa_id\": \"16315551181\"\n              }\n            ],\n            \"messages\": [\n              {\n                \"from\": \"16315551181\",\n                \"id\": \"ABGGFlA5Fpa\",\n                \"timestamp\": \"1504902988\",\n                \"type\": \"text\",\n                \"text\": {\n                  \"body\": \"Hello this is a test message\"\n                }\n              }\n            ]\n          },\n          \"field\": \"messages\"\n        }\n      ]\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/whatsapp/webhook",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "api",
                "whatsapp",
                "webhook"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const secret = pm.environment.get(\"WHATSAPP_APP_SECRET\");",
                  "const body = pm.request.body.raw;",
                  "if (secret && body) {",
                  "    const hash = CryptoJS.HmacSHA256(body, secret).toString(CryptoJS.enc.Hex);",
                  "    pm.request.headers.add({",
                  "        key: \"X-Hub-Signature-256\",",
                  "        value: \"sha256=\" + hash",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Auth Failure: Invalid Signature",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Hub-Signature-256",
                "value": "sha256=invalid_signature_12345"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"object\": \"whatsapp_business_account\",\n  \"entry\": []\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/whatsapp/webhook",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "api",
                "whatsapp",
                "webhook"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 403\", function () {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. GET /api/cron/reminders",
      "item": [
        {
          "name": "Happy Path: Send Reminders",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{CRON_SECRET}}"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/cron/reminders",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "api",
                "cron",
                "reminders"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response has matched and reminders_sent\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"matched\");",
                  "    pm.expect(jsonData).to.have.property(\"reminders_sent\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Auth Failure: Invalid Cron Secret",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer invalid_secret_123"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/cron/reminders",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "api",
                "cron",
                "reminders"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 401\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
}
