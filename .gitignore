# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files — never commit secrets
.env
.env*.local
# .env.production is auto-generated by `vercel env pull` and contains an
# expiring OIDC token + blank placeholders. Set real values in Vercel dashboard.
.env.production
*.postman_environment.json
/webhook-service/.env

# logs and tunnels
untun.log

# scratch/dev files
/scratch/

# vercel
.vercel

# typescript build info
*.tsbuildinfo
next-env.d.ts
